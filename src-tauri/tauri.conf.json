{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoostBochan",
  "version": "0.2.0",
  "identifier": "com.boostbochan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BoostBochan",
        "minWidth": 900,
        "minHeight": 600,
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BoostBochan",
    "shortDescription": "Companion app para League of Legends",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMEQ1NDIyNUEzN0ZBNzAKUldSdytqZGFJbFFOVzFybTI2OUJwVDVRZFN1ZVNtU1kwRTFHVzgveW5sc0RwS2QxVDBxQWhlWDIK",
      "endpoints": ["https://github.com/ivnzmr/boostbochan/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
